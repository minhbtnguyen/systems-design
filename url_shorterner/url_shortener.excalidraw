    {
      "id": "x7zSAbPaF9DGtlJyREbhf",
      "type": "text",
      "x": 1238.6022125006443,
      "y": 530.6061263153294,
      "width": 279.45697021484375,
      "height": 75.8749110447888,
      "angle": 0,
      "strokeColor": "#1e1e1e",
